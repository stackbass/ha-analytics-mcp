# Copy this file to .env and fill in HA_TOKEN.

# --- Home Assistant connection (required) ---------------------------------
HA_URL=https://your-ha-instance.example.com
HA_TOKEN=

# --- Home Assistant connection (optional) ---------------------------------
# Display name used in tool descriptions and responses. Default: Home
HA_NAME=Home
# Overrides the timezone reported by HA. Default: whatever HA reports.
HA_TIMEZONE=Europe/Paris
# Set to 1 to accept self-signed TLS certificates (local HA with its own CA).
# Certificates are VERIFIED by default — only enable this if you must.
# HA_INSECURE_TLS=0

# --- Transport ------------------------------------------------------------
# Default invocation (no arguments) uses the stdio transport; `--http` starts
# the streamable HTTP server. The variables below apply to --http only.
#
# Bind address. Default: 127.0.0.1 (loopback only).
# Binding to a non-loopback address (e.g. 0.0.0.0) REQUIRES MCP_HTTP_TOKEN.
# HOST=127.0.0.1
# Port for --http mode. Default: 3000
# PORT=3000
# Token required on every /mcp request when set. Two accepted forms:
#   1. Authorization: Bearer <token>   (preferred — the token never leaves headers)
#   2. http://<host>:<port>/mcp?token=<token>
# Form 2 exists for Home Assistant's built-in "Model Context Protocol"
# integration, whose config flow offers only a URL field (OAuth otherwise) —
# a query token is the only way to authenticate it. Trade-off: HA's HTTP client
# logs full URLs at INFO level, so the token ends up in the HA log; use a
# dedicated token there and rotate it if the logs are shared.
# Generate one with: openssl rand -hex 32
# MCP_HTTP_TOKEN=

# --- Tuning ---------------------------------------------------------------
# Default row cap for time-series responses. Default: 100
# MAX_RESULTS=100
# Maximum number of in-memory cache entries (LRU eviction). Default: 500
# CACHE_MAX_ENTRIES=500
